APP_ENV=development
SECRET_KEY=change-me
# Local development starts with SQLite. Switch to PostgreSQL when needed.
DATABASE_URL=sqlite:///./smartqa_v3.db
# Cloud Redis URLs may use redis:// or rediss:// and include credentials.
REDIS_URL=redis://localhost:6379/0
# Use your Qdrant Cloud cluster URL and API key for document retrieval.
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=smartqa_chunks
STORAGE_ROOT=./storage
FRONTEND_ORIGIN=http://127.0.0.1:5173
VITE_API_BASE_URL=http://127.0.0.1:8000
COOKIE_SECURE=false
# Keep true for a simple local start. Set false when running the RQ worker.
SYNC_INDEXING=true
MAX_UPLOAD_MB=20
RATE_LIMITING_ENABLED=false
AI_PROVIDER=mock
CHAT_MODEL=meta/llama-3.1-70b-instruct
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=nvidia/nv-embedqa-e5-v5
NVIDIA_API_KEY=
OPENAI_API_KEY=
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=smart-qa-v3
